void setup() {
  pinMode(13,OUTPUT);
  // put your setup code here, to run once:
}

void loop() {
  // put your main code here, to run repeatedly:
  digitalWrite(13,HIGH);
  delay(250);
  digitalWrite(13,LOW);
  delay(100);
  
  digitalWrite(13,HIGH);
  delay(250);
  digitalWrite(13,LOW);
  delay(100);
  
  digitalWrite(13,HIGH);
  delay(250);
  digitalWrite(13,LOW);
  delay(100);
  
  digitalWrite(13,LOW);
  delay(600);
  
  digitalWrite(13,HIGH);
  delay(750);
  digitalWrite(13,LOW);
  delay(250);
  
  digitalWrite(13,HIGH);
  delay(750);
  digitalWrite(13,LOW);
  delay(250);
 
  digitalWrite(13,HIGH);
  delay(750);
  digitalWrite(13,LOW);
  delay(250);
  
  digitalWrite(13,LOW);
  delay(1000);
}
